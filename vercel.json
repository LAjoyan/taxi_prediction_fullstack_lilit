{
  "version": 2,
  "builds": [
    {
      "src": "src/taxipred/backend/api.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["src/taxipred/backend/random_forest_model.joblib"] }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/taxipred/backend/api.py"
    }
  ]
}